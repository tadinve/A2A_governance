{
  "gateway_routes": [
    {"actor": "inventory-agent", "target": "zoho-inventory-mcp", "required_scope": "inventory.read", "effect": "allow"},
    {"actor": "inventory-agent", "target": "procurement-agent", "required_scope": "purchase.request", "effect": "allow"},
    {"actor": "inventory-agent", "target": "procurement-agent", "required_scope": "purchase.status", "effect": "allow"},
    {"actor": "procurement-agent", "target": "zoho-procurement-mcp", "required_scope": "purchaseorder.create", "effect": "allow"},
    {"actor": "procurement-agent", "target": "zoho-procurement-mcp", "required_scope": "purchaseorder.read", "effect": "allow"}
  ],
  "token_exchange": [
    {"actor": "inventory-agent", "subject_audience": "inventory-agent", "subject_scope": "assistant.inventory", "target_audience": "zoho-inventory-mcp", "output_scope": "inventory.read"},
    {"actor": "inventory-agent", "subject_audience": "inventory-agent", "subject_scope": "assistant.inventory", "target_audience": "procurement-agent", "output_scope": "purchase.request"},
    {"actor": "inventory-agent", "subject_audience": "inventory-agent", "subject_scope": "assistant.inventory", "target_audience": "procurement-agent", "output_scope": "purchase.status"},
    {"actor": "procurement-agent", "subject_audience": "procurement-agent", "subject_scope": "purchase.request", "target_audience": "zoho-procurement-mcp", "output_scope": "purchaseorder.create"},
    {"actor": "procurement-agent", "subject_audience": "procurement-agent", "subject_scope": "purchase.status", "target_audience": "zoho-procurement-mcp", "output_scope": "purchaseorder.read"}
  ]
}
