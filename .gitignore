# Python
__pycache__/
*.py[cod]
.venv/
cloud/.venv/
.pytest_cache/

# No signing key is written to disk any more: the Auth Broker holds the only
# key, backed by Cloud KMS in a deployment. This pattern stays as a tripwire so
# a reintroduced key file can never be committed by accident.
*.pem
runtime/*.pid
runtime/*.log

# Generated at run time
evidence/*.jsonl

# OS
.DS_Store

# ADK deploy scratch folders
cloud/*_tmp*/

# Cloud agent virtualenv

# Key staging directories are gone; keep them un-committable if one reappears.
cloud/demo_keys/
cloud/*/demo_keys/
.env_zoho_urls
runtime/*.sqlite3
runtime/*.sqlite3-*
runtime/session_secret
